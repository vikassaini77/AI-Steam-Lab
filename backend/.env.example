# ==============================================================================
# NeuroLab AI Backend Configuration
# ==============================================================================

# Server Network Configuration
PORT=8000
HOST=127.0.0.1

# 1. Google Gemini AI API Key (Required for AI Tutor, ReAct Agent & Vector Embeddings)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Cloud Database (Optional: falls back to local JSON if omitted/unreachable)
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# 3. CORS Allowed Origins (Comma-separated list of origins permitted to call the backend)
# For local dev: http://localhost:5173,http://localhost:80,http://127.0.0.1:5173
# For production: include your deployed frontend URL (e.g. https://your-app.vercel.app,https://your-domain.com)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173

# 4. Sentry Error Tracking & APM (Optional: leave empty to disable)
# Get your DSN from: https://sentry.io -> Project Settings -> Client Keys (DSN)
SENTRY_DSN=

# 5. Prometheus Metrics Security (Problem 7)
# Protects /metrics from unauthorized public access
METRICS_TOKEN=your_secure_monitoring_token_here
METRICS_ALLOW_INTERNAL_NETWORKS=true
METRICS_REQUIRE_AUTH=false

# 6. Security Headers & HSTS (Problem 7)
# Enables Strict-Transport-Security over HTTPS
ENABLE_HSTS=false
ENVIRONMENT=development

# 7. PostgreSQL & pgvector Database Configuration (Problem 8 & Problem 16)
# Required when using PostgreSQL / pgvector instead of Supabase.
# - Inside Docker Compose: The PostgreSQL service is named 'db' on port 5432:
#   POSTGRES_URL=postgresql://stemlab_app:generate_a_strong_database_password_here@db:5432/stemlab
# - Outside containers on local host:
#   POSTGRES_URL=postgresql://stemlab_app:generate_a_strong_database_password_here@localhost:5432/stemlab
POSTGRES_USER=stemlab_app
POSTGRES_PASSWORD=generate_a_strong_database_password_here
POSTGRES_DB=stemlab
POSTGRES_URL=postgresql://stemlab_app:generate_a_strong_database_password_here@db:5432/stemlab
