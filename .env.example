# ==============================================================================
# NeuroLab AI: Environment Configuration Template (.env.example)
# Production, Staging, and Local Development Configuration Contract
# Do NOT store actual secrets or private credentials in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
# Options: development, staging, production, test

# ------------------------------------------------------------------------------
# 2. PostgreSQL & pgvector Database Configuration
# ------------------------------------------------------------------------------
# In Docker Compose, canonical hostname is db:5432:
# POSTGRES_URL=postgresql://stemlab_app:generate_a_strong_database_password_here@db:5432/stemlab
POSTGRES_USER=stemlab_app
POSTGRES_PASSWORD=generate_a_strong_database_password_here
POSTGRES_DB=stemlab
POSTGRES_URL=postgresql://stemlab_app:generate_a_strong_database_password_here@localhost:5432/stemlab
DATABASE_URL=postgresql://stemlab_app:generate_a_strong_database_password_here@localhost:5432/stemlab
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_ACQUISITION_TIMEOUT_SECONDS=3.0

# ------------------------------------------------------------------------------
# 3. Redis Cache & Celery Background Task Broker
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
ASYNC_TASKS_ENABLED=false
# Set to 'true' in production when Redis task worker service is running
CELERY_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 4. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Required for live LLM AI Tutor generation and dynamic physics guidance
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. Computer Vision & YOLO Model Settings
# ------------------------------------------------------------------------------
# In 512MB RAM containers, keep false to use lightweight OpenCV HSV & Lucas-Kanade
ENABLE_YOLO=false
YOLO_WEIGHTS_PATH=backend/weights/yolov8n.pt

# ------------------------------------------------------------------------------
# 6. Supabase Cloud Authentication (Optional / Managed Identity)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# ------------------------------------------------------------------------------
# 7. Security, CORS, and Metrics Authentication
# ------------------------------------------------------------------------------
METRICS_TOKEN=your_secure_metrics_token_here
ALLOWED_ORIGINS=https://anna.partners,https://ai-steam-lab.vercel.app,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
# Content Security Policy override (optional)
# CONTENT_SECURITY_POLICY="default-src 'self'..."

# ------------------------------------------------------------------------------
# 8. Observability, Tracing & Error Tracking (Optional)
# ------------------------------------------------------------------------------
# SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0
LOG_LEVEL=INFO
