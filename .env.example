# ==============================================================================
# NeuroLab AI: Docker Compose Environment Configuration (.env)
# ==============================================================================

# 1. PostgreSQL Database Configuration
# Inside Docker Compose, the database service is named "db" on port 5432
POSTGRES_USER=stemlab_app
POSTGRES_PASSWORD=generate_a_strong_database_password_here
POSTGRES_DB=stemlab
POSTGRES_URL=postgresql://stemlab_app:generate_a_strong_database_password_here@db:5432/stemlab

# 2. Redis Cache & Task Queue
REDIS_URL=redis://redis:6379/0

# 3. Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Supabase Cloud Configuration (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# 5. Metrics & CORS
METRICS_TOKEN=your_secure_metrics_token_here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173
ENVIRONMENT=development

